# Copy to .env (never commit it).

# IPRoyal residential proxy, the same account as the retail audit tool.
# Leave the username and password empty to use this PC's own connection.
PROXY_HOST=geo.iproyal.com
PROXY_PORT=12321
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_COUNTRY=us
PROXY_LIFETIME=24h

# What the browser presents; must agree with the proxy's location.
CAPTURE_TIMEZONE=America/New_York
CAPTURE_LOCALE=en-US

# Optional: where Chrome profiles and outputs live (default: ./profiles, ./output).
# PROFILES_DIR=
# OUTPUT_DIR=
